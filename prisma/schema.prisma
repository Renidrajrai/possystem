// =============================================================================
// CAFÉ POS SYSTEM – Prisma schema (PostgreSQL)
// Place at: server/prisma/schema.prisma
// Conventions
//   - Money: Decimal(12,2). Never Float.
//   - Timestamps: stored in UTC; display Asia/Kathmandu in the UI.
//   - Financial/historical records: no cascade deletes (default Restrict).
//     Void / refund / archive instead of delete.
//   - Snapshots: orders & bills copy names/prices/tax at time of sale.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

// Fulfilment is separate from payment (blueprint rule).
enum FulfilmentStatus {
  OPEN
  SENT_TO_KITCHEN
  IN_PROGRESS
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

enum OrderItemStatus {
  PENDING
  SENT
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum TicketStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum BillStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentTxStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum DiscountType {
  NONE
  FIXED
  PERCENTAGE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_SALE
  PAYOUT
  PETTY_CASH
  CASH_DROP
  CASH_IN
  REFUND
}

enum AdjustmentNoteType {
  CREDIT
  DEBIT
}

enum StockMovementType {
  PURCHASE_RECEIVED
  RECIPE_CONSUMPTION
  CONSUMPTION_REVERSAL
  WASTAGE
  RETURN
  COUNT_ADJUSTMENT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// =============================================================================
// STAFF & ACCESS
// =============================================================================

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // OWNER, MANAGER, CASHIER, KITCHEN
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique // e.g. "order.create", "bill.refund"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true) // deactivate, never delete
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ordersCreated    Order[]
  shifts           Shift[]
  payments         Payment[]
  refundsProcessed Refund[]
  auditLogs        AuditLog[]
  stockMovements   StockMovement[]
  cashMovements    CashMovement[]
  adjustmentNotes  AdjustmentNote[]
  ticketsCancelled KitchenTicket[]  @relation("TicketCancelledBy")
  purchaseOrders   PurchaseOrder[]

  @@index([roleId])
  @@map("users")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?
  action     String // e.g. "DISCOUNT_OVERRIDE", "BILL_VOID", "REFUND", "PRICE_EDIT"
  entityType String
  entityId   String
  reason     String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// CUSTOMERS & MEMBERSHIP
// Phone number is the unique identity. Membership number is generated from an
// auto-increment sequence (membershipSeq) and formatted by the backend.
// Phone is stored normalised (E.164, e.g. +9779812345678).
// =============================================================================

model Customer {
  id               Int      @id @default(autoincrement())
  phone            String   @unique // normalised E.164; one customer per phone
  membershipSeq    Int      @unique @default(autoincrement())
  membershipNumber String   @unique // e.g. "CAFE-000123", set in same transaction as create
  name             String?
  email            String?
  notes            String?
  isActive         Boolean  @default(true)
  joinedAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders Order[]

  @@map("customers")
}

// =============================================================================
// MENU
// =============================================================================

model Category {
  id          Int        @id @default(autoincrement())
  parentId    Int?
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  items       MenuItem[]

  @@index([parentId])
  @@map("categories")
}

model KitchenStation {
  id        Int      @id @default(autoincrement())
  name      String   @unique // Coffee Bar, Kitchen, Bakery
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  menuItems MenuItem[]
  tickets   KitchenTicket[]

  @@map("kitchen_stations")
}

model MenuItem {
  id                     Int      @id @default(autoincrement())
  categoryId             Int
  kitchenStationId       Int?
  name                   String
  description            String?
  imageUrl               String?
  basePrice              Decimal  @db.Decimal(12, 2)
  isAvailable            Boolean  @default(true)
  isActive               Boolean  @default(true) // archive instead of delete
  preparationTimeMinutes Int?
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  category       Category                @relation(fields: [categoryId], references: [id])
  kitchenStation KitchenStation?         @relation(fields: [kitchenStationId], references: [id])
  variants       MenuItemVariant[]
  modifierGroups MenuItemModifierGroup[]
  orderItems     OrderItem[]
  recipes        Recipe[]

  @@index([categoryId])
  @@index([kitchenStationId])
  @@map("menu_items")
}

model MenuItemVariant {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  name       String // Small / Medium / Large
  price      Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id])
  orderItems OrderItem[]
  recipes    Recipe[]

  @@unique([menuItemId, name])
  @@map("menu_item_variants")
}

model ModifierGroup {
  id            Int      @id @default(autoincrement())
  name          String // Milk Type, Extras, Sugar Level
  minSelections Int      @default(0)
  maxSelections Int      @default(1)
  isRequired    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  options   ModifierOption[]
  menuItems MenuItemModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id              Int     @id @default(autoincrement())
  modifierGroupId Int
  name            String
  additionalPrice Decimal @default(0) @db.Decimal(12, 2)
  isAvailable     Boolean @default(true)
  sortOrder       Int     @default(0)

  group              ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId])
  @@map("modifier_options")
}

model MenuItemModifierGroup {
  menuItemId      Int
  modifierGroupId Int
  sortOrder       Int           @default(0)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// =============================================================================
// TABLES
// =============================================================================

model Floor {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  tables    DiningTable[]

  @@map("floors")
}

model DiningTable {
  id       Int         @id @default(autoincrement())
  floorId  Int
  name     String // T1, T2, Window-1
  capacity Int         @default(2)
  status   TableStatus @default(AVAILABLE)
  isActive Boolean     @default(true)

  floor  Floor   @relation(fields: [floorId], references: [id])
  orders Order[]

  @@unique([floorId, name])
  @@map("tables")
}

// =============================================================================
// ORDERS
// =============================================================================

model Order {
  id               Int              @id @default(autoincrement())
  orderNumber      String           @unique
  orderType        OrderType
  tableId          Int?
  customerId       Int?
  createdById      Int
  shiftId          Int?
  fulfilmentStatus FulfilmentStatus @default(OPEN)
  paymentStatus    PaymentStatus    @default(UNPAID)
  subtotal         Decimal          @default(0) @db.Decimal(12, 2)
  discountType     DiscountType     @default(NONE)
  discountValue    Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal          @default(0) @db.Decimal(12, 2)
  discountReason   String?
  serviceCharge    Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal          @default(0) @db.Decimal(12, 2)
  guestCount       Int?
  notes            String?
  cancelReason     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  closedAt         DateTime?

  table     DiningTable? @relation(fields: [tableId], references: [id])
  customer  Customer?    @relation(fields: [customerId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])
  shift     Shift?       @relation(fields: [shiftId], references: [id])

  items   OrderItem[]
  tickets KitchenTicket[]
  bills   Bill[]

  @@index([tableId])
  @@index([customerId])
  @@index([createdById])
  @@index([shiftId])
  @@index([createdAt])
  @@index([fulfilmentStatus])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id                  Int             @id @default(autoincrement())
  orderId             Int
  menuItemId          Int
  variantId           Int?
  itemNameSnapshot    String
  variantNameSnapshot String?
  quantity            Int
  unitPriceSnapshot   Decimal         @db.Decimal(12, 2)
  lineTotal           Decimal         @db.Decimal(12, 2) // (unit + modifiers) * quantity
  notes               String?
  itemStatus          OrderItemStatus @default(PENDING)
  cancelReason        String?
  createdAt           DateTime        @default(now())

  order       Order               @relation(fields: [orderId], references: [id])
  menuItem    MenuItem            @relation(fields: [menuItemId], references: [id])
  variant     MenuItemVariant?    @relation(fields: [variantId], references: [id])
  modifiers   OrderItemModifier[]
  ticketItems KitchenTicketItem[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderItemModifier {
  id                   Int     @id @default(autoincrement())
  orderItemId          Int
  modifierOptionId     Int
  modifierNameSnapshot String
  priceSnapshot        Decimal @db.Decimal(12, 2)
  quantity             Int     @default(1)

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id])
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id])

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// =============================================================================
// KITCHEN
// =============================================================================

model KitchenTicket {
  id            Int          @id @default(autoincrement())
  orderId       Int
  stationId     Int
  ticketNumber  String       @unique
  batchNumber   Int          @default(1) // items added later => new batch
  status        TicketStatus @default(NEW)
  cancelReason  String?
  cancelledById Int?
  createdAt     DateTime     @default(now())
  acceptedAt    DateTime?
  readyAt       DateTime?
  servedAt      DateTime?

  order       Order               @relation(fields: [orderId], references: [id])
  station     KitchenStation      @relation(fields: [stationId], references: [id])
  cancelledBy User?               @relation("TicketCancelledBy", fields: [cancelledById], references: [id])
  items       KitchenTicketItem[]

  @@index([orderId])
  @@index([stationId, status])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id          Int          @id @default(autoincrement())
  ticketId    Int
  orderItemId Int
  quantity    Int
  status      TicketStatus @default(NEW)

  ticket    KitchenTicket @relation(fields: [ticketId], references: [id])
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([ticketId])
  @@index([orderItemId])
  @@map("kitchen_ticket_items")
}

// =============================================================================
// BILLING & PAYMENTS
// =============================================================================

model PaymentMethod {
  id                Int       @id @default(autoincrement())
  name              String    @unique // Cash, QR, Card, eSewa, Bank Transfer
  isActive          Boolean   @default(true)
  requiresReference Boolean   @default(false)
  isCash            Boolean   @default(false) // cash drawer, change and shift cash tracking
  payments          Payment[]

  @@map("payment_methods")
}

model Bill {
  id            Int        @id @default(autoincrement())
  orderId       Int
  billNumber    String     @unique
  subtotal      Decimal    @db.Decimal(12, 2)
  discount      Decimal    @default(0) @db.Decimal(12, 2)
  serviceCharge Decimal    @default(0) @db.Decimal(12, 2)
  tax           Decimal    @default(0) @db.Decimal(12, 2)
  totalDue      Decimal    @db.Decimal(12, 2)
  amountPaid    Decimal    @default(0) @db.Decimal(12, 2)
  status        BillStatus @default(ISSUED)
  voidReason    String?
  issuedAt      DateTime   @default(now())
  paidAt        DateTime?

  order           Order            @relation(fields: [orderId], references: [id])
  items           BillItem[]
  payments        Payment[]
  adjustmentNotes AdjustmentNote[]

  @@index([orderId])
  @@index([status])
  @@index([issuedAt])
  @@map("bills")
}

model BillItem {
  id                  Int     @id @default(autoincrement())
  billId              Int
  descriptionSnapshot String
  quantity            Int
  unitPrice           Decimal @db.Decimal(12, 2)
  taxRate             Decimal @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal @db.Decimal(12, 2)

  bill Bill @relation(fields: [billId], references: [id])

  @@index([billId])
  @@map("bill_items")
}

model Payment {
  id                Int             @id @default(autoincrement())
  billId            Int
  paymentMethodId   Int
  receivedById      Int?
  shiftId           Int?
  amount            Decimal         @db.Decimal(12, 2)
  amountTendered    Decimal?        @db.Decimal(12, 2) // cash given
  changeGiven       Decimal?        @db.Decimal(12, 2)
  status            PaymentTxStatus @default(PENDING)
  providerReference String?         @unique
  idempotencyKey    String          @unique
  failureReason     String?
  createdAt         DateTime        @default(now())
  paidAt            DateTime?

  bill          Bill          @relation(fields: [billId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  receivedBy    User?         @relation(fields: [receivedById], references: [id])
  shift         Shift?        @relation(fields: [shiftId], references: [id])
  refunds       Refund[]

  @@index([billId])
  @@index([paymentMethodId])
  @@index([shiftId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id            Int      @id @default(autoincrement())
  paymentId     Int
  amount        Decimal  @db.Decimal(12, 2)
  reason        String
  processedById Int
  createdAt     DateTime @default(now())

  payment     Payment @relation(fields: [paymentId], references: [id])
  processedBy User    @relation(fields: [processedById], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// Credit / debit notes: correct issued bills without editing or deleting them.
model AdjustmentNote {
  id          Int                @id @default(autoincrement())
  billId      Int
  noteNumber  String             @unique
  type        AdjustmentNoteType
  amount      Decimal            @db.Decimal(12, 2)
  taxAmount   Decimal            @default(0) @db.Decimal(12, 2)
  reason      String
  createdById Int
  createdAt   DateTime           @default(now())

  bill      Bill @relation(fields: [billId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([billId])
  @@map("adjustment_notes")
}

// =============================================================================
// TAX, SETTINGS & NUMBERING (rules live in data, not in code)
// =============================================================================

model TaxProfile {
  id       Int                @id @default(autoincrement())
  name     String             @unique // "VAT Standard", "Exempt"
  isActive Boolean            @default(true)
  rates    TaxRate[]
  settings BusinessSettings[]

  @@map("tax_profiles")
}

model TaxRate {
  id            Int       @id @default(autoincrement())
  taxProfileId  Int
  name          String
  ratePercent   Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  taxProfile TaxProfile @relation(fields: [taxProfileId], references: [id])

  @@index([taxProfileId, effectiveFrom])
  @@map("tax_rates")
}

// Single-row table (id = 1).
model BusinessSettings {
  id                        Int      @id @default(1)
  businessName              String
  address                   String?
  phone                     String?
  panNumber                 String?
  vatNumber                 String?
  currency                  String   @default("NPR")
  timezone                  String   @default("Asia/Kathmandu")
  receiptFooter             String?
  serviceChargePct          Decimal  @default(0) @db.Decimal(5, 2) // applied to DINE_IN orders only
  defaultTaxProfileId       Int? // null = no tax charged until the owner configures it
  pricesIncludeTax          Boolean  @default(false)
  maxCashierDiscountPercent Decimal  @default(10) @db.Decimal(5, 2)
  updatedAt                 DateTime @updatedAt

  defaultTaxProfile TaxProfile? @relation(fields: [defaultTaxProfileId], references: [id])

  @@map("business_settings")
}

// Controlled, gap-free numbering. Increment inside the same transaction as issue.
model InvoiceSequence {
  id         Int      @id @default(autoincrement())
  key        String   @unique // "ORDER", "BILL", "KOT", "NOTE" (+ fiscal year if needed)
  prefix     String   @default("")
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@map("invoice_sequences")
}

// =============================================================================
// SHIFTS & CASH
// =============================================================================

model Shift {
  id                  Int         @id @default(autoincrement())
  userId              Int
  status              ShiftStatus @default(OPEN)
  openedAt            DateTime    @default(now())
  closedAt            DateTime?
  openingCash         Decimal     @db.Decimal(12, 2)
  expectedClosingCash Decimal?    @db.Decimal(12, 2)
  actualClosingCash   Decimal?    @db.Decimal(12, 2)
  cashDifference      Decimal?    @db.Decimal(12, 2)
  notes               String?

  user          User           @relation(fields: [userId], references: [id])
  orders        Order[]
  payments      Payment[]
  cashMovements CashMovement[]

  @@index([userId])
  @@index([status])
  @@map("shifts")
}

model CashMovement {
  id          Int              @id @default(autoincrement())
  shiftId     Int
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  reason      String?
  createdById Int
  createdAt   DateTime         @default(now())

  shift     Shift @relation(fields: [shiftId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([shiftId])
  @@map("cash_movements")
}

// =============================================================================
// INVENTORY, RECIPES & PURCHASING (later phase – schema ready)
// =============================================================================

model InventoryItem {
  id              Int      @id @default(autoincrement())
  name            String
  sku             String?  @unique
  unit            String // g, kg, ml, litre, piece
  currentQuantity Decimal  @default(0) @db.Decimal(14, 3) // cache; must reconcile to ledger
  reorderLevel    Decimal  @default(0) @db.Decimal(14, 3)
  costPerUnit     Decimal  @default(0) @db.Decimal(12, 4)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipeItems        RecipeItem[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("inventory_items")
}

model Recipe {
  id            Int     @id @default(autoincrement())
  menuItemId    Int
  variantId     Int?
  name          String
  yieldQuantity Int     @default(1)
  isActive      Boolean @default(true)

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id])
  variant  MenuItemVariant? @relation(fields: [variantId], references: [id])
  items    RecipeItem[]

  @@index([menuItemId])
  @@map("recipes")
}

model RecipeItem {
  id               Int     @id @default(autoincrement())
  recipeId         Int
  inventoryItemId  Int
  quantityRequired Decimal @db.Decimal(14, 3)
  unit             String

  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([recipeId, inventoryItemId])
  @@map("recipe_items")
}

model StockMovement {
  id              BigInt            @id @default(autoincrement())
  inventoryItemId Int
  movementType    StockMovementType
  quantityDelta   Decimal           @db.Decimal(14, 3) // + in, - out
  unitCost        Decimal?          @db.Decimal(12, 4)
  referenceType   String? // "ORDER_ITEM", "PURCHASE_ORDER", ...
  referenceId     String?
  note            String?
  createdById     Int?
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  createdBy     User?         @relation(fields: [createdById], references: [id])

  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  supplierId  Int
  createdById Int?
  status      PurchaseOrderStatus @default(DRAFT)
  orderedAt   DateTime?
  receivedAt  DateTime?
  totalCost   Decimal             @default(0) @db.Decimal(12, 2)
  createdAt   DateTime            @default(now())

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User?               @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int     @id @default(autoincrement())
  purchaseOrderId  Int
  inventoryItemId  Int
  quantityOrdered  Decimal @db.Decimal(14, 3)
  quantityReceived Decimal @default(0) @db.Decimal(14, 3)
  unitCost         Decimal @db.Decimal(12, 4)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}
