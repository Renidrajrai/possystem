# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (your React app)
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_pos?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# --- Business rules ---
# Offset of café local time from UTC in minutes (Nepal = 345 for UTC+05:45)
TZ_OFFSET_MINUTES=345
TIMEZONE=Asia/Kathmandu
# Used when a phone number is entered without a country code (Nepal = 977)
DEFAULT_COUNTRY_CODE=977
# Membership numbers look like CAFE-000123
MEMBERSHIP_PREFIX=CAFE

# --- Seeding (npm run db:seed) ---
SEED_ADMIN_NAME="Café Owner"
SEED_ADMIN_EMAIL=owner@cafe.local
SEED_ADMIN_PASSWORD=ChangeMe-Now-123
# true = also create demo staff, floor/tables and a small sample menu
SEED_DEMO=false
